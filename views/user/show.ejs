<% include ../partials/header.ejs %>
<script>
	function numberWithCommas(x) {
    	var price =  x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
		return price;
	}	
	var prc = numberWithCommas(<%= theProduct.price %>);
</script>

<div class="container">
	<header class="jumbotron bg-warning" style="margin-top: 70px;">
		<div class="container">
			<h1><i class="fas fa-store"></i> <%=currentUser.username.toUpperCase()%> </h1>
			<p> The best shopping platform in the universe.</p>
			<a class="btn btn-primary" href="/products/new" role="button"><i class="fas fa-plus-square"></i> Add new products!</a>
			<a class="btn btn-primary" href="/<%=currentUser.username%>/products" role="button"><i class="fas fa-arrow-circle-right"></i> Go to product list!</a>
			<a class="btn btn-primary" href="/<%=currentUser.username%>/dashboard" role="button"><i class="fas fa-arrow-circle-right"></i> Go to Dashboard!</a>
		</div>
	</header>
</div>

<div class="card mt-4 mb-3">
	<div class="row no-gutters">
		<aside class="col-sm-5 border-right">
			<article class="gallery-wrap" style="margin-top: 15%;">
				<div class="img-big-wrap" style="background: transparent">
	  				<div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
					  <ol class="carousel-indicators">
						<li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
					<% if(theProduct.image2 != ""){ %>
						<li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
					<% } %>
					<% if(theProduct.image3 != ""){ %>
						<li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
					<% } %>
					  </ol>
					  <div class="carousel-inner">
						<div class="carousel-item active">
						  <img class="d-block center" src="<%= theProduct.image1 %>" alt="First Image" style="max-width: 290px; height: 315px; border-radius: 5%;">
						</div>
					<% if(theProduct.image2 != ""){ %>
						<div class="carousel-item">
						  <img class="d-block center" src="<%= theProduct.image2 %>" alt="Second Image" style="max-width: 290px; height: 315px;border-radius: 5%;">
						</div>
					<% } %>
					<% if(theProduct.image3 != ""){ %>
						<div class="carousel-item">
						  <img class="d-block center" src="<%= theProduct.image3 %>" alt="Third Image" style="max-width: 290px; height: 315px; border-radius: 5%;">
						</div>
					<% } %>
					  </div>
					  <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="sr-only">Previous</span>
					  </a>
					  <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="sr-only">Next</span>
					  </a>
					</div>
				</div> <!-- slider-product.// -->
				<div class="img-small-wrap d-none d-sm-block">
				  <div class="item-gallery"> <img style="width:70px ;height: 60px" src="<%= theProduct.image1 %>"></div>
				<% if(theProduct.image2 != ""){ %>
				  <div class="item-gallery"> <img style="width:70px ;height: 60px" src="<%= theProduct.image2 %>"></div>
				<% } %>
				<% if(theProduct.image3 != ""){ %>
				  <div class="item-gallery"> <img style="width:70px ;height: 60px" src="<%= theProduct.image3 %>"></div>
				<% } %>
				</div> <!-- slider-nav.// -->  
			</article> <!-- gallery-wrap .end// --> 
		</aside>
		<aside class="col-sm-7">
			<article class="p-5">
				<h3 class="title mb-3"><%= theProduct.name %></h3>
				<div class="mb-3"> 
					<var class="price h3 text-warning"> 
						<span class="currency">Rp. </span><span class="num"><script>document.write(prc)</script></span>
					</var> 
					<span>/pcs</span> 
				</div> <!-- price-detail-wrap .// -->
				<hr>
				<dl>
  					<dt>Description</dt>
  					<dd><p style="text-align: justify; white-space: pre-wrap;"><%= theProduct.description %></p></dd>
				</dl>
				<dl class="row">
				  <dt class="col-sm-3">COD</dt>
				  <dd class="col-sm-9">Area Kampus UGM </dd>

				  <dt class="col-sm-3">Delivery</dt>
				  <dd class="col-sm-9">Seluruh Indonesia</dd>
				</dl>
				<div class="rating-wrap">

					<ul class="rating-stars">
						<li style="width:80%" class="stars-active"> 
							<i class="fa fa-star"></i> <i class="fa fa-star"></i> 
							<i class="fa fa-star"></i> <i class="fa fa-star"></i> 
							<i class="fa fa-star"></i> 
						</li>
						<li>
							<i class="fa fa-star"></i> <i class="fa fa-star"></i> 
							<i class="fa fa-star"></i> <i class="fa fa-star"></i> 
							<i class="fa fa-star"></i> 
						</li>
					</ul>
					<div class="label-rating">132 reviews</div>
					<div class="label-rating">154 orders </div>
				</div> <!-- rating-wrap.// -->
	
				<hr>
				
				<form action="/<%=currentUser.username%>/products/<%=theProduct._id%>/edit" method="GET" class="d-none d-inline mr-3">
					<button id="tombolEdit" class="btn btn-success d-none d-sm-inline"><i class="fas fa-edit"></i> EDIT </button>	
				</form>
				
				<form action="/<%=currentUser.username%>/products/<%=theProduct._id%>?_method=DELETE" method="POST" class="d-none d-inline">
					<button id="tombolDelete" class="btn btn-danger"><i class="fas fa-trash-alt"></i> DELETE </button>	
				</form>
				
				</article> <!-- card-body.// -->
			</aside> <!-- col.// -->
		</div> <!-- row.// -->
	</div> <!-- card.// -->
<% include ../partials/footer.ejs %>