<% include ../partials/header.ejs %>
@import url(https://fonts.googleapis.com/css?family=Raleway:300,400,600);
<link rel="stylesheet" href="/signup.css">
<link rel="stylesheet" href="/modern.css">

<main class="my-form mt-3 fadeInDown">
    <div class="cotainer">
        <div class="row justify-content-center">
            <div class="col-md-8">
            	<div class="card">
                    <div class="card-header">Register <i class="fas fa-user-plus"></i></div>
                        <div class="card-body">
							<!-- FORM  Start-->
                            <form action="/signup" method="POST">
                                <div class="form-group row fadeIn first">
                                    <label for="full_name" class="col-md-4 col-form-label text-md-right">Full Name</label>
                                    <div class="col-md-6">
                                        <input type="text" id="full_name" class="form-control" name="fullName">
                                    </div>
                                </div>

                                <div class="form-group row  fadeIn second">
                                    <label for="email_address" class="col-md-4 col-form-label text-md-right">E-Mail Address</label>
                                    <div class="col-md-6">
                                        <input type="text" id="email_address" class="form-control" name="email">
                                    </div>
                                </div>
								
								<div class="form-group row  fadeIn second">
                                    <label for="email_address" class="col-md-4 col-form-label text-md-right">Password</label>
                                    <div class="col-md-6">
                                        <input type="password" id="password" class="form-control" name="password">
                                    </div>
                                </div>

                                <div class="form-group row fadeIn third">
                                    <label for="user_name" class="col-md-4 col-form-label text-md-right">Username</label>
                                    <div class="col-md-6">
                                        <input type="text" id="user_name" class="form-control" name="username">
                                    </div>
                                </div>

                                <div class="form-group row fadeIn fourth">
                                    <label for="phone_number" class="col-md-4 col-form-label text-md-right">Phone Number</label>
                                    <div class="col-md-6">
                                        <input type="text" id="phone_number" class="form-control" name="phone">
                                    </div>
                                </div>

                                <div class="form-group row fadeIn fifth">
                                    <label for="present_address" class="col-md-4 col-form-label text-md-right">Present Address</label>
                                    <div class="col-md-6">
                                        <input type="text" id="present_address" class="form-control" name="address">
                                    </div>
                                </div>
								
                                <div class="col-md-6 offset-md-4 fadeIn eighth">
                    	            <button id="tombol" type="submit" class="btn btn-primary">
                    	                Register
                                    </button>
								</div>
                            </form>
							<!-- FORM END -->
                        </div>
                    </div>
            	</div>
        	</div>
    	</div>
	</main>
<% include ../partials/footer.ejs %>