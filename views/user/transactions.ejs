<% include ../partials/header.ejs %>

<div class="container mt-5">
  <div class="pb-3">
    <div class="">
      <div class="row">
        <div class="col-lg-12 p-3 bg-white rounded shadow-sm mt-5 mb-3">

          <!-- Shopping cart table -->
          <div style="align-content-center">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col" class="border-0 bg-light">
                    <div class="p-2 px-3 text-uppercase" style="font-size: 13px; text-align: center;">Transaction ID</div>
                  </th>
				  <th scope="col" class="border-0 bg-light">
                    <div class="p-2 px-3 text-uppercase" style="font-size: 13px; text-align: center;">Type</div>
                  </th>
				  <th scope="col" class="border-0 bg-light">
                    <div class="p-2 px-3 text-uppercase" style="font-size: 13px; text-align: center;">Status</div>
                  </th>
                </tr>
              </thead>
              <tbody>
				  
			<div class="row text-center mt-3 mb-3" style="display: flex; flex-wrap: wrap;">
				<div class="col-lg-12">
					<h3> - Transactions History - </h3>
				</div>
			</div>
			<!-- -------------------LOGIC BEGIN ------------------------- -->
			<% transaction.forEach(function(foundOne){ %>
                <tr>
                  <th scope="row" class="border-0">
                    <div class="p-0" style="text-align: center;">
						<a href="/<%=currentUser.username%>/invoice/<%= foundOne._id %>">#<%= foundOne._id %></a>
                    </div>
                  </th>
				  <th scope="row" class="border-0">
                    <div class="p-0" style="text-align: center;">
					<%if(currentUser._id == foundOne.sellerId){ %>
						<h5 style="color: #d60000">PENJUALAN</h5>
					<% }else { %>
						<h5 style="color: #1fa318">PEMBELIAN</h5>
					<% } %>
                    </div>
                  </th>
				  <th scope="row" class="border-0">
                    <div class="p-0" style="text-align: center;">
						<h5><%= foundOne.status %></h5>
                    </div>
                  </th>
                </tr>
		<%	}); %>
				<!-- -----------------------------LOGIC END ---------------------------->
              </tbody>
            </table>
          </div>
          <!-- End -->
        </div>
      </div>
		
<div class="row bg-white rounded shadow-sm d-flex justify-content-center">
<div class="col-lg-6 col-md-8 col-sm-10">
	</div>
		</div></div></div></div>

<% include ../partials/footer.ejs %>