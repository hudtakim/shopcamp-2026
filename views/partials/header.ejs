<DOCTYPE! html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width,initial-scale=1.0">
		<title>ShopCamp.id</title>
		<link rel="stylesheet" href="/shop.css">
		<link href="/ui.css" rel="stylesheet">
		<link href="/candy.css" rel="stylesheet">
		<link href="css/responsive.css" rel="stylesheet" media="only screen and (max-width: 1200px)">
		<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-	ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
		<script src="https://kit.fontawesome.com/623a66995a.js"></script>
		<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>	
	</head>	
	<body>
		<nav class="navbar navbar-dark navbar-expand-md fixed-top">
			<div class="container-fluid">
				<div class="navbar-header">
					<a class="navbar-brand" href="/"><i class="fab fa-playstation"></i> ShopCamp</a>
				</div>
				<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
    				<span class="navbar-toggler-icon"></span>
  				</button>
				<div class="collapse navbar-collapse" id="navbarSupportedContent">
					<ul class="navbar-nav mr-auto">
						<li class="nav-item"><a class="nav-link" href="/products">Products</a></li>	
					</ul>
					<ul class="navbar-nav ml-auto">
					<% if(!currentUser){%>
						<li class="nav-item"><a href="/login" id="goLogin" class="nav-link">Login</a></li>
						<li class="nav-item"><a href="/signup" id="goRegister" class="nav-link">Sign Up</a></li>
					<% } else{ %>
						<script>
							function numberWithCommas(x) {
								var price =  x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
								return price;
							}
							var saldo = <%=currentUser.saldo%>;
							var theSaldo = numberWithCommas(saldo);
						</script>
						<li class="nav-item"><a href="/<%=currentUser.username%>/topup" class="nav-link" id="navInvoice"><i class="fas fa-wallet"></i>  <script>document.write(theSaldo)</script></a></li>
						<li class="nav-item"><a href="/<%=currentUser.username%>/transactions" class="nav-link" id="navInvoice"><i class="fas fa-exchange-alt"></i> Transaction</a></li>
						<li class="nav-item"><a href="/<%=currentUser.username%>/cart" class="nav-link" id="navInvoice"><i class="fas fa-shopping-cart"></i> Cart</a></li>
						<li class="nav-item"><a href="/<%=currentUser.username%>/dashboard" class="nav-link"><%= currentUser.username %></a></li>
						<li class="nav-item"><a href="/logout" id="goLogout" class="nav-link">Logout</a></li>
					<% } %>	
					</ul>
				</div>
			</div>
		</nav>